# Copie para .env.local e preencha. O .env.local NÃO deve ser versionado.
# "mock" (padrão, offline e determinístico) ou "nvidia" (API real).
VITE_IA_PROVEDOR=nvidia

# Chave da NVIDIA. Sem o prefixo VITE_, ela fica restrita ao proxy do Vite e
# não é incluída no bundle enviado ao navegador.
NVIDIA_API_KEY=nvapi-substitua-pela-sua-chave

# Modelo NIM compatível com a API OpenAI.
VITE_NVIDIA_MODELO=nvidia/nemotron-3.5-lightning-30b-a3b

# Tempo limite da chamada real, em milissegundos.
VITE_NVIDIA_TIMEOUT_MS=30000

# Opcional (NÃO recomendado): chamada direta do navegador, sem proxy.
# A chave fica visível no bundle. Use apenas em build/deploy controlado.
# VITE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# VITE_NVIDIA_API_KEY=nvapi-substitua-pela-sua-chave
